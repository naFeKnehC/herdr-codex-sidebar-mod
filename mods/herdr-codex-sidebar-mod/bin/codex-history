#!/bin/sh
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

find_node() {
  for candidate in "$HOME"/.nvm/versions/node/*/bin/node /opt/homebrew/bin/node /usr/local/bin/node; do
    [ -x "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
  done
  command -v node 2>/dev/null
}

NODE=$(find_node || true)
if [ -z "$NODE" ]; then
  printf '%s\n' "codex-history: node was not found" >&2
  exit 127
fi

MAIN="$HERE/../helper/codex-history.mjs"
[ -f "$MAIN" ] || MAIN="$HERE/../codex-history.mjs"

exec "$NODE" "$MAIN" "$@"
